{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "panel",
  "name": "Grafana Intelligence Gateway (Private)",
  "id": "digitalrcs-intelligencegateway-panel",
  "info": {
    "keywords": ["ai", "llm", "openai", "lmstudio", "intelligence", "assessment", "vision", "panel"],
    "description": "Assess panel query data, reviewed dashboard captures, or uploaded images with local or hosted AI. Connect through the required DigitalRCS secure AI data source.",
    "author": {
      "name": "DigitalRCS",
      "url": "https://www.digitalrcs.com"
    },
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "links": [
      {
        "name": "DigitalRCS",
        "url": "https://www.digitalrcs.com"
      },
      {
        "name": "Documentation",
        "url": "https://github.com/digitalrcs/grafana-intelligence-gateway-private/wiki"
      },
      {
        "name": "Source",
        "url": "https://github.com/digitalrcs/grafana-intelligence-gateway-private"
      },
      {
        "name": "Internal issues",
        "url": "https://github.com/digitalrcs/grafana-intelligence-gateway-private/issues"
      }
    ],
    "screenshots": [
      {
        "name": "Local AI analysis of synthetic panel data with LM Studio",
        "path": "img/panel-analysis.png"
      }
    ],
    "version": "%VERSION%",
    "updated": "%TODAY%"
  },
  "dependencies": {
    "grafanaDependency": ">=11.6.0",
    "plugins": [
      {
        "id": "digitalrcs-intelligencegateway-datasource",
        "type": "datasource",
        "name": "Intelligence Gateway Secure AI"
      }
    ]
  }
}
